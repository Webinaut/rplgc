---
const year = new Date();
---

<div class="container-fluid">
  <footer>
    Site By: <a href="https://mart-i-n.com.au/">Mart.I.N</a> &copy; The Royal
    Park Ladies Golf Club &middot; 2025 -{" "}
    <span id="footer-year">{year.getFullYear()}</span>
  </footer>
</div>

<style>
  .container-fluid {
    min-height: 70px;
    background-color: var(--pico-primary-background);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  footer {
    color: var(--pico-primary-inverse);
    text-align: center;
    font-size: 0.9rem;
  }

  footer a {
    color: var(--pico-primary-hover);
  }

  footer a:hover {
    color: var(--pico-primary-inverse);
    text-decoration: underline;
  }
</style>
